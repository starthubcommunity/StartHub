# automation/.env.example
# Bu dosyayı kopyalayıp ".env" adıyla kaydet, gerçek değerleri gir.
# .env dosyası .gitignore'da — asla commit etme!

# ── Gemini ──────────────────────────────────────────────────────────────
# Google AI Studio'dan alınır: https://aistudio.google.com/app/apikey
GEMINI_API_KEY= AQ.Ab8RN6J_CrjXbykGDFmF6iDdAzrWC-zmNihoGrWZHVfrBiciTQ

# Model adı (varsayılan config.py'de tanımlı, override etmek istersen yaz)
# GEMINI_MODEL=gemini-2.5-flash

# Günde kaç haber üretilsin (varsayılan: 2)
# DAILY_LIMIT=2

# ── Google Sheets ────────────────────────────────────────────────────────
# Google Cloud Console'dan servis hesabı JSON'unun TAM içeriği (tek satır)
# Oluşturma: IAM → Service Accounts → JSON key indir → içeriği buraya yapıştır
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Sheets dosyasının tam adı (Google Drive'daki görünen isim)
SHEET_NAME=Start-Hub Yayın Planı

# ── GitHub ───────────────────────────────────────────────────────────────
# Repo write izni olan Personal Access Token (Settings → Developer settings → PAT)
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "kullanici/repo-adi" formatında
GH_REPO=kullanici/start-hub

# ── Supabase (ileride kullanılacak) ─────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
